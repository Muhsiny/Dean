<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:layoutDirection="rtl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WiFi Control Direct v4"
            android:textStyle="bold"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TP-Link TD-W8961N V4 • Direct HTTP Engine • بدون WebView"
            android:textSize="13sp"
            android:paddingBottom="10dp" />

        <EditText
            android:id="@+id/routerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="http://192.168.1.1"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="نام کاربری ادمین"
            android:inputType="text" />

        <EditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="رمز ادمین"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/connectBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اتصال مستقیم به روتر" />

        <Button
            android:id="@+id/refreshBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تازه‌سازی دستگاه‌ها"
            android:enabled="false" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="آماده"
            android:textStyle="bold"
            android:paddingTop="10dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/capabilities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="قابلیت‌ها پس از اتصال مستقیم از خود روتر خوانده می‌شوند."
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/managerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="دستگاه مدیر مشخص نشده است."
            android:textStyle="bold"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="دستگاه‌های متصل"
            android:textStyle="bold"
            android:textSize="21sp"
            android:paddingTop="10dp" />

        <LinearLayout
            android:id="@+id/clientList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ضد اشتراک رمز / QR"
            android:textStyle="bold"
            android:textSize="21sp"
            android:paddingTop="14dp" />

        <Button
            android:id="@+id/antiQrBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="فعال‌سازی Allow‑List برای دستگاه‌های تیک‌شده"
            android:enabled="false" />

        <Button
            android:id="@+id/filterOffBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="خاموش‌کردن Wireless MAC Filter"
            android:enabled="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مصرف کل اینترنت"
            android:textStyle="bold"
            android:textSize="21sp"
            android:paddingTop="14dp" />

        <Button
            android:id="@+id/statsBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="خواندن Byte Counter واقعی"
            android:enabled="false" />

        <TextView
            android:id="@+id/statsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="قفل ایمنی: MAC روتر و دستگاه مدیر Block نمی‌شوند. هیچ Reboot/Reset/Upgrade/WAN/ADSL در این اپ اجرا نمی‌شود. هر تغییر فقط پس از POST واقعی و بازخوانی مجدد از روتر موفق شمرده می‌شود."
            android:paddingTop="16dp"
            android:paddingBottom="24dp" />
    </LinearLayout>
</ScrollView>
