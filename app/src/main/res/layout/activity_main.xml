<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:layoutDirection="rtl"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="مرکز کنترل وای‌فای" android:textStyle="bold" android:textSize="28sp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TP-Link TD-W8961N V4 • نسخه 2.1 Firmware Profiler" android:textSize="13sp" android:paddingBottom="8dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="این نسخه دیگر نتیجهٔ حدسی را موفق اعلام نمی‌کند. ابتدا ساختار واقعی firmware همین روتر استخراج می‌شود. تا وقتی endpointهای واقعی Verify نشده‌اند، فرمان‌های Block/Anti‑QR عمداً غیرفعال می‌مانند." android:padding="12dp"/><EditText android:id="@+id/routerUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="http://192.168.1.1" android:inputType="textUri"/><EditText android:id="@+id/username" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="نام کاربری ادمین" android:inputType="text"/><EditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="رمز ادمین" android:inputType="textPassword"/><Button android:id="@+id/scanBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="اتصال و تازه‌سازی دستگاه‌های واقعی"/><Button android:id="@+id/calibrateBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="استخراج نقشه واقعی Firmware → فایل JSON"/><TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="آماده" android:paddingTop="10dp" android:paddingBottom="10dp"/><TextView android:id="@+id/protectedStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تلفن مدیر هنوز مشخص نشده" android:textStyle="bold" android:padding="10dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="دستگاه‌ها" android:textStyle="bold" android:textSize="20sp" android:paddingTop="10dp"/><LinearLayout android:id="@+id/clientList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="کنترل دسترسی" android:textStyle="bold" android:textSize="20sp" android:paddingTop="14dp"/><Button android:id="@+id/antiQrBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="فعال‌سازی ضد QR واقعی — پس از Verify firmware" android:enabled="false"/><Button android:id="@+id/antiQrOffBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="خاموش‌کردن ضد QR — پس از Verify firmware" android:enabled="false"/><Button android:id="@+id/emergencyBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="بازگردانی اضطراری — پس از Verify firmware" android:enabled="false"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="هدف: پس از خواندن فایل Firmware Map، endpoint و نام دقیق فیلدهای همین Build به موتور Native وصل می‌شود؛ سپس Block/Unblock فقط پس از SAVE و خواندنِ دوبارهٔ نتیجه از خود روتر موفق شمرده خواهد شد." android:paddingTop="14dp"/></LinearLayout></ScrollView>